{
  "name": "@dashkite/altair",
  "version": "0.4.4",
  "description": "Smart HTTP client",
  "keywords": [],
  "homepage": "https://github.com/dashkite/altair#readme",
  "bugs": {
    "url": "https://github.com/dashkite/altair/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashkite/altair.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "contributors": [
    "Dan Yoder <dan@dashkite.com>",
    "David Harper <david@dashkite.com>",
    "Chand Rajendra-Nicolucci <chand@dashkite.com>"
  ],
  "exports": {
    ".": {
      "browser": "./build/browser/src/index.js",
      "node": "./build/node/src/index.js"
    },
    "./*": {
      "browser": "./build/browser/src/*/index.js",
      "node": "./build/node/src/*/index.js"
    },
    "./cache/install": {
      "browser": "./build/browser/src/cache/install.js",
      "node": "./build/node/src/cache/install.js"
    }
  },
  "files": [
    "build/browser/src",
    "build/node/src"
  ],
  "imports": {
    "#helpers/*": {
      "browser": "./build/browser/src/helpers/*.js",
      "node": "./build/node/src/helpers/*.js"
    }
  },
  "scripts": {
    "test": "genie test",
    "build": "genie build",
    "release": "genie release"
  },
  "devDependencies": {
    "@dashkite/amen": "^0.9.13",
    "@dashkite/amen-console": "^0.4.0",
    "@dashkite/assert": "^0.3.0",
    "@dashkite/atlas": "^0.9.0",
    "@dashkite/drn-sky": "^0.8.17",
    "@dashkite/genie": "^0.20.14",
    "@dashkite/genie-clean": "^0.9.0",
    "@dashkite/genie-coffee": "^0.9.0",
    "@dashkite/genie-drn": "^0.12.19",
    "@dashkite/genie-media": "^0.12.14",
    "@dashkite/genie-module": "^0.5.42",
    "@dashkite/genie-pug": "^0.4.1",
    "@dashkite/genie-release": "^0.5.0",
    "@dashkite/genie-yaml": "^0.8.0",
    "@dashkite/reactive": "^0.7.19",
    "@dashkite/registry": "^0.17.12",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "puppeteer": "^24.22.0"
  },
  "dependencies": {
    "@dashkite/http-headers": "^0.12.37",
    "@dashkite/joy": "^0.12.23",
    "@dashkite/scout": "^0.5.0",
    "@dashkite/sierra": "^0.3.15",
    "@dashkite/sky-sublime": "link:../sky-sublime",
    "@dashkite/sublime": "link:../sublime"
  }
}
